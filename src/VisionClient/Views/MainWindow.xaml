<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VisionClient.ViewModels"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="VisionClient.Views.MainWindow"
        Title="WPF Vision Client Skeleton" Height="760" Width="1200"
        Background="#1E1E1E" Foreground="White">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 좌측: 고속 영상 뷰어 영역 -->
        <Border Grid.Column="0" Background="#111111" BorderBrush="#333333" BorderThickness="1" Margin="0,0,10,0">
            <Image Source="{Binding DisplayImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <!-- 우측: 제어 및 판정 결과 패널 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 판정 배지 -->
            <Border Grid.Row="0" Background="{Binding StatusColor}" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text="{Binding CycleTimeText}" FontSize="14" HorizontalAlignment="Center" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- 트리거 버튼 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <Button Content="Single Grab" Command="{Binding GrabOnceCommand}" Height="40" Margin="0,0,0,6" FontWeight="Bold" />
                <Button Command="{Binding ToggleLiveCommand}" Height="40" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Content" Value="Start Live" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiveRunning}" Value="True">
                                    <Setter Property="Content" Value="Stop Live" />
                                    <Setter Property="Background" Value="#D9534F" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- 검사 로그 -->
            <GroupBox Grid.Row="2" Header="Inspection Logs" BorderBrush="#444444">
                <ListBox ItemsSource="{Binding Logs}" Background="#141414" Foreground="#CCCCCC" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>